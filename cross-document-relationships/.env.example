# Cross-Document Relationships Environment Configuration
# Copy this to your .env file and update with your actual values

# =============================================================================
# GEMINI 2.0 FLASH CONFIGURATION
# =============================================================================

# Multiple Gemini API Keys (comma-separated for rotation)
# Example: key1,key2,key3
GEMINI_API_KEYS=your_gemini_key_1,your_gemini_key_2,your_gemini_key_3

# =============================================================================
# AUTO ANALYSIS CONFIGURATION 
# =============================================================================

# Set to 'true' to automatically start relationship assignment when server starts
# When enabled, server sẽ tự động tìm và gán mối quan hệ cross-document ngay khi khởi động
AUTO_START_ANALYSIS=true

# Parameters for automatic analysis (chỉ có hiệu lực khi AUTO_START_ANALYSIS=true)
AUTO_MAX_PAIRS=1000          # Số entity pairs tối đa để phân tích
AUTO_BATCH_SIZE=10           # Kích thước batch cho LLM calls
AUTO_SIMILARITY_THRESHOLD=0.75  # Ngưỡng similarity để xác định potential relationships

# Single Gemini API Key (fallback if GEMINI_API_KEYS not set)
GEMINI_API_KEY=your_single_gemini_api_key

# =============================================================================
# ANALYSIS PARAMETERS
# =============================================================================

# Similarity threshold for finding entity pairs (0.0-1.0)
CROSS_DOC_SIMILARITY_THRESHOLD=0.75

# Confidence threshold for creating relationships (0.0-1.0)
CROSS_DOC_CONFIDENCE_THRESHOLD=0.6

# Batch size for processing entity pairs
CROSS_DOC_BATCH_SIZE=50

# Maximum entity pairs to process in one analysis run
CROSS_DOC_MAX_PAIRS=1000

# =============================================================================
# LLM CONFIGURATION
# =============================================================================

# Gemini model name
CROSS_DOC_LLM_MODEL=gemini-2.0-flash

# LLM temperature (0.0-2.0)
CROSS_DOC_LLM_TEMPERATURE=0.1

# Maximum output tokens
CROSS_DOC_LLM_MAX_TOKENS=2048

# Maximum retries per API call
CROSS_DOC_MAX_RETRIES=3

# Retry delay in seconds (exponential backoff applied)
CROSS_DOC_RETRY_DELAY=1.0

# =============================================================================
# PROCESSING SETTINGS
# =============================================================================

# Maximum context length for entities
CROSS_DOC_MAX_CONTEXT_LENGTH=500

# Enable parallel processing (true/false)
CROSS_DOC_PARALLEL_PROCESSING=true

# Analysis version for tracking
CROSS_DOC_ANALYSIS_VERSION=1.0

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR)
CROSS_DOC_LOG_LEVEL=INFO

# Log file path
CROSS_DOC_LOG_FILE=cross_document_analysis.log

# =============================================================================
# EXAMPLE CONFIGURATION FOR DEVELOPMENT
# =============================================================================

# Development setup with multiple test keys
# GEMINI_API_KEYS=AIzaSyA...,AIzaSyB...,AIzaSyC...
# CROSS_DOC_SIMILARITY_THRESHOLD=0.7
# CROSS_DOC_CONFIDENCE_THRESHOLD=0.5
# CROSS_DOC_BATCH_SIZE=25
# CROSS_DOC_MAX_PAIRS=500
# CROSS_DOC_LOG_LEVEL=DEBUG

# =============================================================================
# PRODUCTION CONFIGURATION EXAMPLE
# =============================================================================

# Production setup with optimized parameters
# GEMINI_API_KEYS=prod_key_1,prod_key_2,prod_key_3,prod_key_4,prod_key_5
# CROSS_DOC_SIMILARITY_THRESHOLD=0.8
# CROSS_DOC_CONFIDENCE_THRESHOLD=0.7
# CROSS_DOC_BATCH_SIZE=100
# CROSS_DOC_MAX_PAIRS=2000
# CROSS_DOC_MAX_RETRIES=5
# CROSS_DOC_RETRY_DELAY=2.0
# CROSS_DOC_LOG_LEVEL=WARNING
