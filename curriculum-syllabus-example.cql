// --- Bước 1: Tạo/Cập nhật Node cho môn học MAN104 và các thuộc tính chi tiết ---
MERGE (c:Course {code: 'MAN104'}) ON CREATE SET c = {code: 'MAN104', name_vi: 'Quản Lý Dự Án Công Nghệ Thông Tin', name_en: 'Information Technology Project Management', credits_details: '3 (3,0) TC', prerequisites_text: 'Công nghệ phần mềm (CMP101) – Học phần học trước.', objectives: 'Học phần cung cấp kiến thức và kỹ năng cho sinh viên để lập kế hoạch và quản lý dự án công nghệ thông tin, cũng như quá trình giám sát, điều chỉnh dự án sao cho phù hợp với tình hình thực tế. Sinh viên sẽ nắm bắt các kỹ năng và sử dụng các phần mềm quản lý dự án. Từ đó sinh viên có thể triển khai một dự án phần mềm.', summary: 'Học phần này bao gồm các kiến thức cơ bản về quản lý dự án công nghệ thông tin, bao gồm các qui trình quản lý phạm vi, thời gian, chi phí, chất lượng, nhân sự, truyền thông, rủi ro, mua sắm và tích hợp dự án. Ngoài ra, học phần cũng tập trung vào việc lập kế hoạch, giám sát và điều chỉnh dự án để phù hợp với tình hình thực tế. Các công cụ và kỹ thuật hỗ trợ cũng được sử dụng trong quá trình quản lý dự án.', level: 'Đại học', document_code: 'MAN104'} ON MATCH SET c += {code: 'MAN104', name_vi: 'Quản Lý Dự Án Công Nghệ Thông Tin', name_en: 'Information Technology Project Management', credits_details: '3 (3,0) TC', prerequisites_text: 'Công nghệ phần mềm (CMP101) – Học phần học trước.', objectives: 'Học phần cung cấp kiến thức và kỹ năng cho sinh viên để lập kế hoạch và quản lý dự án công nghệ thông tin, cũng như quá trình giám sát, điều chỉnh dự án sao cho phù hợp với tình hình thực tế. Sinh viên sẽ nắm bắt các kỹ năng và sử dụng các phần mềm quản lý dự án. Từ đó sinh viên có thể triển khai một dự án phần mềm.', summary: 'Học phần này bao gồm các kiến thức cơ bản về quản lý dự án công nghệ thông tin, bao gồm các qui trình quản lý phạm vi, thời gian, chi phí, chất lượng, nhân sự, truyền thông, rủi ro, mua sắm và tích hợp dự án. Ngoài ra, học phần cũng tập trung vào việc lập kế hoạch, giám sát và điều chỉnh dự án để phù hợp với tình hình thực tế. Các công cụ và kỹ thuật hỗ trợ cũng được sử dụng trong quá trình quản lý dự án.', level: 'Đại học', document_code: 'MAN104'};

