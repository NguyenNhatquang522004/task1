// --- Bước 3: Tạo các Node PLO, PI và mối quan hệ từ ma trận ---
MERGE (p:PLO {id: 'PLO2'});
MERGE (pi:PI {id: 'PI2.1'});
MATCH (p:PLO {id: 'PLO2'}), (pi:PI {id: 'PI2.1'}) MERGE (pi)-[:PART_OF]->(p);
MATCH (c:Course {code: 'CMP179'}), (pi:PI {id: 'PI2.1'}) MERGE (c)-[:CONTRIBUTES_TO {level: 2}]->(pi);
MERGE (pi:PI {id: 'PI2.2'});
MATCH (p:PLO {id: 'PLO2'}), (pi:PI {id: 'PI2.2'}) MERGE (pi)-[:PART_OF]->(p);
MATCH (c:Course {code: 'CMP179'}), (pi:PI {id: 'PI2.2'}) MERGE (c)-[:CONTRIBUTES_TO {level: 3}]->(pi);
MERGE (p:PLO {id: 'PLO7'});
MERGE (pi:PI {id: 'PI7.1'});
MATCH (p:PLO {id: 'PLO7'}), (pi:PI {id: 'PI7.1'}) MERGE (pi)-[:PART_OF]->(p);
MATCH (c:Course {code: 'CMP179'}), (pi:PI {id: 'PI7.1'}) MERGE (c)-[:CONTRIBUTES_TO {level: 2}]->(pi);

// --- Bước 4: Tạo các Node Chuẩn đầu ra (CLO) và mối quan hệ ---
MERGE (clo:CLO {id: 'CMP179_CLO1'}) SET clo = {id: 'CMP179_CLO1', short_id: 'CLO1', description: 'Xác định các khái niệm về kiểm thử, quản lý chất lượng phần mềm, kịch bản kiểm thử và quản lý lỗi phần mềm.', corresponding_plo: 'PLO2'};
MATCH (c:Course {code: 'CMP179'}), (clo:CLO {id: 'CMP179_CLO1'}) MERGE (c)-[:HAS_CLO]->(clo);
MATCH (clo:CLO {id: 'CMP179_CLO1'}), (pi:PI {id: 'PI2.1'}) MERGE (clo)-[:MEASURED_BY]->(pi);
MERGE (clo:CLO {id: 'CMP179_CLO2'}) SET clo = {id: 'CMP179_CLO2', short_id: 'CLO2', description: 'Áp dụng các kỹ thuật kiểm thử hộp đen, hộp trắng, đơn vị và kiểm thử tự động để giải quyết các dự án thực tế.', corresponding_plo: 'PLO2'};
MATCH (c:Course {code: 'CMP179'}), (clo:CLO {id: 'CMP179_CLO2'}) MERGE (c)-[:HAS_CLO]->(clo);
MATCH (clo:CLO {id: 'CMP179_CLO2'}), (pi:PI {id: 'PI2.2'}) MERGE (clo)-[:MEASURED_BY]->(pi);
MERGE (clo:CLO {id: 'CMP179_CLO3'}) SET clo = {id: 'CMP179_CLO3', short_id: 'CLO3', description: 'Thể hiện thành thạo khả năng làm việc độc lập và khả năng hợp tác làm việc nhóm để thực hiện đồ án.', corresponding_plo: 'PLO7'};
MATCH (c:Course {code: 'CMP179'}), (clo:CLO {id: 'CMP179_CLO3'}) MERGE (c)-[:HAS_CLO]->(clo);
MATCH (clo:CLO {id: 'CMP179_CLO3'}), (pi:PI {id: 'PI7.1'}) MERGE (clo)-[:MEASURED_BY]->(pi);

// --- Bước 5: Tạo các Node Bài học (Topic) và Khái niệm (Concept) ---
MERGE (t:Topic {id: 'CMP179_1'}) ON CREATE SET t = {id: 'CMP179_1', short_id: '1', title: 'TỔNG QUAN VỀ KIỂM THỬ VÀ ĐẢM BẢO CHẤT LƯỢNG PHẦN MỀM', theory_hours: 5.0, practice_hours: 0.0} ON MATCH SET t += {id: 'CMP179_1', short_id: '1', title: 'TỔNG QUAN VỀ KIỂM THỬ VÀ ĐẢM BẢO CHẤT LƯỢNG PHẦN MỀM', theory_hours: 5.0, practice_hours: 0.0};
