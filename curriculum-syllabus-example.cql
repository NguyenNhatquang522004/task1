// --- Bước 1: Tạo/Cập nhật Node cho môn học CMP179 và các thuộc tính chi tiết ---
MERGE (c:Course {code: 'CMP179'}) ON CREATE SET c = {code: 'CMP179', name_vi: 'Kiểm thử và đảm bảo chất lượng phần mềm', name_en: 'Software Testing and Quality Assurance', credits_details: '3 (3, 0) TC', prerequisites_text: '', objectives: 'Học phần trang bị cho sinh viên kiến thức về kiểm thử và đảm bảo chất lượng phần mềm, bao gồm các phương pháp kiểm thử, kỹ thuật thiết kế kịch bản, công cụ kiểm thử tự động và quản lý lỗi phần mềm. Sinh viên có thể áp dụng các kỹ thuật kiểm thử, sử dụng công cụ hỗ trợ, phân tích và lựa chọn phương pháp phù hợp để đảm bảo chất lượng phần mềm trong thực tế. Đồng thời, học phần rèn luyện tư duy cẩn trọng, trách nhiệm, tuân thủ quy trình kiểm thử và sẵn sàng tiếp cận các công nghệ mới nhằm nâng cao hiệu quả làm việc.', summary: 'Học phần cung cấp kiến thức nền tảng về kiểm thử và đảm bảo chất lượng phần mềm, các kỹ thuật kiểm thử hộp đen, hộp trắng, kiểm thử đơn vị, thiết kế kịch bản kiểm thử, các công cụ kiểm thử và quản lý lỗi phần mềm.', level: 'Đại học', document_code: ''} ON MATCH SET c += {code: 'CMP179', name_vi: 'Kiểm thử và đảm bảo chất lượng phần mềm', name_en: 'Software Testing and Quality Assurance', credits_details: '3 (3, 0) TC', prerequisites_text: '', objectives: 'Học phần trang bị cho sinh viên kiến thức về kiểm thử và đảm bảo chất lượng phần mềm, bao gồm các phương pháp kiểm thử, kỹ thuật thiết kế kịch bản, công cụ kiểm thử tự động và quản lý lỗi phần mềm. Sinh viên có thể áp dụng các kỹ thuật kiểm thử, sử dụng công cụ hỗ trợ, phân tích và lựa chọn phương pháp phù hợp để đảm bảo chất lượng phần mềm trong thực tế. Đồng thời, học phần rèn luyện tư duy cẩn trọng, trách nhiệm, tuân thủ quy trình kiểm thử và sẵn sàng tiếp cận các công nghệ mới nhằm nâng cao hiệu quả làm việc.', summary: 'Học phần cung cấp kiến thức nền tảng về kiểm thử và đảm bảo chất lượng phần mềm, các kỹ thuật kiểm thử hộp đen, hộp trắng, kiểm thử đơn vị, thiết kế kịch bản kiểm thử, các công cụ kiểm thử và quản lý lỗi phần mềm.', level: 'Đại học', document_code: ''};

// --- Bước 2: Tạo Node Giảng viên ---
