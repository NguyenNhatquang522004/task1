# Neo4j Database Configuration
VITE_NEO4J_URI="neo4j+s://your-database-url"
VITE_NEO4J_USERNAME="neo4j"
VITE_NEO4J_PASSWORD="your-password"
VITE_NEO4J_DATABASE="neo4j"

# Backend API Configuration  
VITE_BACKEND_API_URL="http://localhost:8000"

# Existing configuration...
VITE_BLOOM_URL="https://workspace-preview.neo4j.io/workspace/explore?connectURL={CONNECT_URL}&search=Show+me+a+graph&featureGenAISuggestions=true&featureGenAISuggestionsInternal=true"
VITE_REACT_APP_SOURCES="local,youtube,wiki,s3,web"
VITE_LLM_MODELS="gemini_2.0_flash,gemini_1.5_flash,gemini_1.5_pro,gemini_2.5_pro"
VITE_ENV="DEV"
VITE_TIME_PER_PAGE=50
VITE_TOKENS_PER_CHUNK=5000
VITE_CHUNK_TO_COMBINE=9
VITE_CHUNK_SIZE=5242880
VITE_CHUNK_OVERLAP=350
VITE_LARGE_FILE_SIZE=5242880
VITE_GOOGLE_CLIENT_ID=""
VITE_CHAT_MODES="graph_vector_fulltext"
VITE_BATCH_SIZE=2
VITE_LLM_MODELS_PROD="gemini_2.0_flash,gemini_1.5_flash,gemini_1.5_pro,gemini_2.5_pro"
VITE_FRONTEND_HOSTNAME="localhost:8080"
VITE_SEGMENT_API_URL=""
VITE_AUTH0_CLIENT_ID=""
VITE_AUTH0_DOMAIN=""
VITE_SKIP_AUTH=true
